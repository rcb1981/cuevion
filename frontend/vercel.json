{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{venv/**,frontend/**,__pycache__/**,dist/**,node_modules/**}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/onboarding-preview",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/out-of-office-worker",
      "schedule": "* * * * *"
    }
  ]
}
